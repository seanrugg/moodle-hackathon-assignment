<?xml version="1.0" encoding="UTF-8" ?>
<XML>
  <TABLES>
    <TABLE NAME="hackathon" COMMENT="Main activity table">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="course" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="true" DEFAULT=""/>
        <FIELD NAME="intro" TYPE="text" NOTNULL="false"/>
        <FIELD NAME="slides_mandatory" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="1"/>
        <FIELD NAME="slides_type" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="2"/> <!-- 0: File, 1: Link, 2: Both -->
        <FIELD NAME="video_mandatory" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="video_type" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="2"/> <!-- 0: File, 1: Link, 2: Both -->
        <FIELD NAME="site_mandatory" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="repo_mandatory" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="groupmode" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0"/> <!-- 0: No groups, 1: Separate groups, 2: Visible groups -->
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
    </TABLE>
    <TABLE NAME="hackathon_submissions" COMMENT="Submissions table">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="hackathonid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="groupid" TYPE="int" LENGTH="10" NOTNULL="false" DEFAULT="0"/>
        <FIELD NAME="slides_url" TYPE="text" NOTNULL="false"/>
        <FIELD NAME="video_url" TYPE="text" NOTNULL="false"/>
        <FIELD NAME="site_url" TYPE="text" NOTNULL="false"/>
        <FIELD NAME="repo_url" TYPE="text" NOTNULL="false"/>
        <FIELD NAME="submitted" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
    </TABLE>
  </TABLES>
</XML>
